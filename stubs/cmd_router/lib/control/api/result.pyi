from cmd_router.utils.cli import *
from cmd_router.utils.logger import *
from cmd_router.lib.command import CmdParse
from collections.abc import Callable
from dataclasses import dataclass
from typing import Any

__all__ = ["ControlResult", "ControlInitialization"]

_Action = Callable[..., Any]

class _UNSET: ...

@dataclass(frozen=True, slots=True)
class ControlResult:
    def __bool__(self) -> bool: ...
    ok: bool
    code: int
    kind: str
    input: Any
    command: str | None = ...
    value: Any = ...
    parse_result: CmdParse.Result | None = ...
    context: CmdParse.Context | None = ...
    handler: _Action | None = ...
    error: CmdParse.Error | None = ...
    message: str = ...
    exception: str | None = ...
    data: Any = ...
    error_payload: Any = ...
    def __set_attr__(self, name: str, value: Any) -> None: ...
    def __post_init__(self) -> None: ...
    @property
    def is_success(self) -> bool: ...
    @property
    def parsed_args(self) -> dict[str, Any]: ...
    @property
    def result(self) -> Any: ...
    @property
    def suggestions(self) -> list[str]: ...
    def to_response(self) -> dict[str, Any]: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self, is_response: bool = False): ...
    as_response = to_response
    as_dict = to_dict
    as_json = to_json
    @staticmethod
    def _transport_value(value: Any) -> Any: ...
    def _all_data(self, response_only: bool = False) -> dict[str, Any]: ...

@dataclass(frozen=True, slots=True)
class ControlInitialization:
    ok: bool
    code: int
    message: str = ...
    command_count: int = ...
    exception: str | None = ...
    def __bool__(self) -> bool: ...
    def to_dict(self) -> dict[str, Any]: ...
    as_dict = to_dict
