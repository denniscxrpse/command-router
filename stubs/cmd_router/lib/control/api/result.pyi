from collections.abc import Callable
from dataclasses import dataclass
from typing import Any

from cmd_router.lib.command import CmdParse

__all__ = ["ControlResult", "ControlInitialization"]

_Action = Callable[..., Any]

@dataclass(frozen=True, slots=True)
class ControlResult:
    def __bool__(self) -> bool: ...
    ok: bool
    code: int
    kind: str
    input: Any
    command: str | None = ...
    value: Any = ...
    parse_result: CmdParse.Result | None = ...
    context: CmdParse.Context | None = ...
    handler: _Action | None = ...
    error: CmdParse.Error | None = ...
    message: str = ...
    exception: str | None = ...
    @property
    def is_success(self) -> bool: ...
    @property
    def parsed_args(self) -> dict[str, Any]: ...
    @property
    def result(self) -> Any: ...
    def to_dict(self) -> dict[str, Any]: ...
    as_dict = to_dict

@dataclass(frozen=True, slots=True)
class ControlInitialization:
    ok: bool
    code: int
    message: str = ...
    command_count: int = ...
    exception: str | None = ...
    def __bool__(self) -> bool: ...
    def to_dict(self) -> dict[str, Any]: ...
    as_dict = to_dict
